# ===================================================
# Environment Configuration for Chatbot RAG
# ===================================================

# (Optional) GitHub Personal Access Token for remote API models or HuggingFace/GitHub interactions
GITHUB_TOKEN="your_github_token_here"

# (Optional) Google Gemini API Key if using Gemini LLM integration
GOOGLE_API_KEY="your_gemini_api_key_here"

# Ollama local LLM host (Default: http://localhost:11434)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
